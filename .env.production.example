# ============================================
# Production Environment Configuration
# ============================================

# Docker Compose Settings
APP_PORT=80
DB_PORT=5432
UID=1000
GID=1000

# ============================================
# Application Settings
# ============================================
APP_NAME="Daytrip Atlas"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://daytrip-atlas.com

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ============================================
# Logging
# ============================================
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# ============================================
# Database Settings (PostgreSQL + PostGIS)
# ============================================
DB_CONNECTION=pgsql
DB_HOST=db
DB_DATABASE=daytrip_atlas_db
DB_USERNAME=daytrip_user
DB_PASSWORD=  # 強力なパスワードを設定 (最低16文字推奨)

# ============================================
# Cache & Session
# ============================================
CACHE_STORE=database  # 将来的に redis へ移行
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ============================================
# Queue
# ============================================
QUEUE_CONNECTION=database  # 将来的に redis へ移行

# ============================================
# Storage
# ============================================
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ============================================
# External API Keys
# ============================================
# Google Maps API Key (フロントエンド用)
VITE_GOOGLE_MAPS_API_KEY=  # 要設定

# Gemini API Key (AI機能用)
GEMINI_API_KEY=  # 要設定

# Gemini API Debug Settings
GEMINI_LOG_PROMPTS=false

# ============================================
# AI Analysis Settings
# ============================================
AI_ASYNC_ANALYSIS_ENABLED=true
AI_TASK_A_TYPE_PROBABILITY=0.5
AI_MAX_CONCURRENT_TASKS_PER_TYPE=3
AI_TASK_LOCK_TIMEOUT_MINUTES=30

# Cache TTL (秒単位)
AI_CACHE_TTL_SPOT_LISTING=2592000      # 30日
AI_CACHE_TTL_SPOT_PRIORITY=2592000     # 30日
AI_CACHE_TTL_MAIN_SPOT=2592000         # 30日
AI_CACHE_TTL_IMAGE=2592000             # 30日
AI_CACHE_TTL_SPOT_DETAIL=7776000       # 90日
AI_CACHE_TTL_CATCHPHRASE=604800        # 7日
AI_CACHE_TTL_MODEL_PLAN=2592000        # 30日

# AI Model Settings
AI_MODEL_INTERVAL_SAFETY_MARGIN=1.2
AI_MODEL_EXECUTION_HISTORY_HOURS=24
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_BACKOFF_SECONDS=60

# Debug Logging (本番環境では false 推奨)
AI_DEBUG_LOG_JOB_EXECUTION=false
AI_DEBUG_LOG_TASK_SELECTION=false

# ============================================
# Mail (オプション)
# ============================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# Redis (将来的に使用)
# ============================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================
# AWS S3 (将来的に使用)
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================
# Vite (ビルド時に使用)
# ============================================
VITE_APP_NAME="${APP_NAME}"
