# Multi-stage build for production
# Stage 1: Composer dependencies
FROM composer:latest AS composer-builder

WORKDIR /app

COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-plugins \
    --no-scripts \
    --prefer-dist \
    --optimize-autoloader

COPY . .
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-plugins \
    --prefer-dist \
    --optimize-autoloader

# Stage 2: Production PHP image
FROM php:8.3-fpm

ARG UID=1000
ARG GID=1000

WORKDIR /var/www

# 必要なPHP拡張機能とライブラリをインストール
RUN apt-get update && apt-get install -y \
    git \
    unzip \
    libpq-dev \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libzip-dev \
    curl \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) gd pdo pdo_pgsql pgsql zip opcache \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# PHP設定ファイルをコピー (本番用)
COPY ./.docker/php/production.ini /usr/local/etc/php/conf.d/production.ini

# ユーザー作成 (セキュリティ向上)
RUN groupadd -g $GID appuser && \
    useradd -u $UID -g appuser -s /bin/bash -m appuser

# アプリケーションファイルをコピー
COPY --chown=appuser:appuser . .

# Composerの依存関係をコピー
COPY --from=composer-builder --chown=appuser:appuser /app/vendor ./vendor

# ディレクトリ権限設定
RUN mkdir -p storage bootstrap/cache && \
    chown -R appuser:appuser storage bootstrap/cache && \
    chmod -R 775 storage bootstrap/cache

# PHP-FPM healthcheck script
RUN echo '#!/bin/sh\n\
SCRIPT_NAME=/ping \
SCRIPT_FILENAME=/ping \
REQUEST_METHOD=GET \
cgi-fcgi -bind -connect 127.0.0.1:9000' > /usr/local/bin/php-fpm-healthcheck && \
    chmod +x /usr/local/bin/php-fpm-healthcheck && \
    apt-get update && apt-get install -y libfcgi-bin && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# PHP-FPMの設定でpingパスを有効化
RUN echo "pm.status_path = /status" >> /usr/local/etc/php-fpm.d/www.conf && \
    echo "ping.path = /ping" >> /usr/local/etc/php-fpm.d/www.conf && \
    echo "ping.response = pong" >> /usr/local/etc/php-fpm.d/www.conf

EXPOSE 9000

CMD ["php-fpm"]
